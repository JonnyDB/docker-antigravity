#!/bin/bash
# Autostart entrypoint executed inside the Wayland (labwc) session as user 'abc'

# Export environment paths preserving /lsiopy/bin
export HOME="/config"
export NPM_CONFIG_PREFIX="/config/.npm-global"
export PYTHONUSERBASE="/config/.local"
export PIPX_HOME="/config/.pipx"
export PIPX_BIN_DIR="/config/.local/bin"
export PATH="/lsiopy/bin:/config/.local/bin:/config/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"

cd /config/workspace || cd /config

echo "[autostart_wayland] Launching Google Antigravity 2.0 Desktop..."
/usr/local/bin/antigravity &
