# Docker Antigravity 2.0 Environment Configuration

# User and Group mapping (run 'id' on your host to find your values)
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# Desktop Window Title
TITLE=Google Antigravity 2.0

# Optional: Pin a specific version of Antigravity Desktop
# ANTIGRAVITY_VERSION=2.11.0-6376446768316416

# Optional: Auto-update on container start (true/false)
# AUTO_UPDATE=false

# Optional: HTTP Basic Authentication for Web Desktop (ports 3000/3001)
# CUSTOM_USER=admin
# PASSWORD=secretpassword

# Optional: Sudo Password for abc user
# SUDO_PASSWORD=password

# Optional: Pre-seed OAuth Token
# ANTIGRAVITY_OAUTH_TOKEN=
